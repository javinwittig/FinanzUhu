<mvc:View controllerName="project1.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
    xmlns="sap.m">
    <Page showHeader="false" class="fhPage" backgroundDesign="Transparent">
        <VBox class="fhContent">
            <core:Fragment fragmentName="project1.view.fragment.KpiRow" type="XML" />

            <f:Card class="fhSectionCard">
                <f:content>
                    <VBox>
                        <VBox class="fhCardPad sapUiSmallMarginBottom">
                            <Title text="{i18n>homeTrendTitle}" level="H4" />
                            <Text text="{i18n>homeTrendSubtitle}" class="fhTextMute" />
                        </VBox>

                        <viz:VizFrame id="trendLineChart" vizType="line" height="280px"
                            uiConfig="{applicationSet:'fiori'}">
                            <viz:dataset>
                                <vizData:FlattenedDataset data="{finance>/trend}">
                                    <vizData:dimensions>
                                        <vizData:DimensionDefinition name="Monat" value="{finance>month}" />
                                    </vizData:dimensions>
                                    <vizData:measures>
                                        <vizData:MeasureDefinition name="Einnahmen" value="{finance>income}" />
                                        <vizData:MeasureDefinition name="Ausgaben" value="{finance>expense}" />
                                    </vizData:measures>
                                </vizData:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Einnahmen,Ausgaben" />
                                <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Monat" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </VBox>
                </f:content>
            </f:Card>

            <f:Card class="fhSectionCard">
                <f:content>
                    <VBox class="fhCardPad">
                        <!-- Profile head -->
                        <HBox alignItems="Center" class="fhProfileHead">
                            <Avatar initials="AW" displaySize="L" backgroundColor="Accent6" class="sapUiTinyMarginEnd" />
                            <VBox justifyContent="Center">
                                <HBox alignItems="Center">
                                    <Title text="{finance>/app/user/fullName}" level="H3" class="sapUiTinyMarginEnd" />
                                    <ObjectStatus text="{finance>/app/user/tier}" state="Information" inverted="true" />
                                </HBox>
                                <Text text="{finance>/app/user/email}" class="fhTextSoft" />
                                <Text text="{finance>/app/user/member}" class="fhTextMute" />
                            </VBox>
                        </HBox>

                        <l:Grid defaultSpan="XL4 L4 M4 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop">
                            <VBox>
                                <Label text="{i18n>lastLogin}" class="fhTextMute" />
                                <Text text="{finance>/app/user/lastLogin}" class="fhStatValue" />
                            </VBox>
                            <VBox alignItems="Center">
                                <Label text="{i18n>securityLevel}" class="fhTextMute" />
                                <ObjectStatus text="{finance>/app/user/security}" state="Success" />
                            </VBox>
                            <VBox alignItems="End">
                                <Label text="{i18n>dataState}" class="fhTextMute" />
                                <Text text="{finance>/app/user/dataState}" class="fhStatValue" />
                            </VBox>
                        </l:Grid>

                        <Button text="{i18n>profileManage}"
                            type="Emphasized"
                            width="100%"
                            class="sapUiSmallMarginTop"
                            press=".onManageProfile" />
                    </VBox>
                </f:content>
            </f:Card>
        </VBox>
    </Page>
</mvc:View>
