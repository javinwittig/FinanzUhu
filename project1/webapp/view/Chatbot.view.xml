<mvc:View controllerName="project1.controller.Chatbot"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page title="{i18n>chatbotTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="false"
        class="fhPage fhChatPage">
        <FlexBox direction="Column" height="100%" width="100%" renderType="Bare">
            <!-- Message list — grows to fill available space -->
            <ScrollContainer id="chatScroll"
                vertical="true"
                class="fhChatScroll"
                width="100%">
                <layoutData>
                    <FlexItemData growFactor="1" minHeight="0px" />
                </layoutData>
                <List id="chatList"
                    items="{chat>/messages}"
                    showSeparators="None"
                    class="fhChatList">
                    <CustomListItem>
                        <HBox class="fhChatRow"
                            justifyContent="{= ${chat>role} === 'user' ? 'End' : 'Start' }">
                            <VBox class="fhBubble">
                                <customData>
                                    <core:CustomData key="chatrole" value="{chat>role}" writeToDom="true" />
                                </customData>
                                <Text text="{chat>text}" renderWhitespace="true" width="100%" />
                            </VBox>
                        </HBox>
                    </CustomListItem>
                </List>
            </ScrollContainer>

            <!-- Input bar — always visible above the root bottom-nav -->
            <Toolbar id="chatInputBar" class="fhChatInputBar" width="100%">
                <Input id="chatInput"
                    placeholder="{i18n>chatbotPlaceholder}"
                    submit=".onSend"
                    enabled="{= !${chat>/busy} }" />
                <Button id="chatSend"
                    icon="sap-icon://paper-plane"
                    type="Emphasized"
                    press=".onSend"
                    enabled="{= !${chat>/busy} }" />
            </Toolbar>
        </FlexBox>
    </Page>
</mvc:View>
